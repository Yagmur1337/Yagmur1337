local function customFireProximityPrompt(prompt, breakMode)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		warn("[FIRE PP] Invalid ProximityPrompt!")
		return false
	end
	
	local holdDuration = prompt.HoldDuration or 0
	breakMode = breakMode or false  -- true = multiple quick hits (breaking), false = single hold (collecting)
	
	print(string.format("[FIRE PP] Prompt: %s, Hold: %.2fs, BreakMode: %s", prompt.Name or "Unknown", holdDuration, tostring(breakMode)))
	
	-- Method 1: getconnections (BEST for Delta)
	if getconnections then
		local success = pcall(function()
			if breakMode then
				-- BREAKING MODE: Quick successive hits (for cash registers, vents)
				for hit = 1, 5 do
					-- Just fire Triggered quickly
					local triggered = getconnections(prompt.Triggered)
					if triggered then
						for _, conn in pairs(triggered) do
							if conn and conn.Function then
								pcall(function() conn:Fire() end)
							end
						end
					end
					
					task.wait(0.12)  -- Short delay between hits
					
					-- Check if it broke (prompt disabled)
					if not prompt.Enabled then
						print(string.format("[FIRE PP] ✅ Broken after %d hits!", hit))
						return
					end
				end
				print("[FIRE PP] ✅ Breaking complete (5 hits)")
			else
				-- COLLECTING MODE: Single hold (TV, CashPile, etc.)
				-- Start holding
				local holdBegan = getconnections(prompt.PromptButtonHoldBegan)
				if holdBegan then
					for _, conn in pairs(holdBegan) do
						if conn and conn.Function then
							pcall(function() conn:Fire() end)
						end
					end
				end
				
				-- Hold for the duration
				local totalHold = math.max(holdDuration, 0.3) + 0.15
				task.wait(totalHold)
				
				-- Trigger the action
				local triggered = getconnections(prompt.Triggered)
				if triggered then
					for _, conn in pairs(triggered) do
						if conn and conn.Function then
							pcall(function() conn:Fire() end)
						end
					end
				end
				
				task.wait(0.05)
				
				-- Release hold
				local holdEnded = getconnections(prompt.PromptButtonHoldEnded)
				if holdEnded then
					for _, conn in pairs(holdEnded) do
						if conn and conn.Function then
							pcall(function() conn:Fire() end)
						end
					end
				end
				
				print(string.format("[FIRE PP] ✅ Single hold complete (%.2fs)", totalHold))
			end
		end)
		
		if success then return true end
	end
	
	-- Method 2: fireproximityprompt (Synapse, Script-Ware)
	if fireproximityprompt then
		local success = pcall(function()
			if breakMode then
				for i = 1, 5 do
					fireproximityprompt(prompt)
					task.wait(0.12)
					if not prompt.Enabled then break end
				end
			else
				fireproximityprompt(prompt)
				task.wait(math.max(holdDuration, 0.3))
			end
			print("[FIRE PP] ✅ fireproximityprompt success")
		end)
		
		if success then return true end
	end
	
	warn("[FIRE PP] ❌ All methods failed!")
	return false
end
	warn("[FIRE PP] ❌ All methods failed!")
	return false
end

